{
    "name": "guardlms/laravel",
    "description": "Report installed Laravel, Composer and server inventory to GuardLMS.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0",
        "illuminate/http": "^11.0 || ^12.0",
        "composer-runtime-api": "^2.2"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "GuardLms\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GuardLms\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GuardLms\\Laravel\\GuardLmsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
